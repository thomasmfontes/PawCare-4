{
  "expo": {
    "name": "PawCare",
    "slug": "pawcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pawcare",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0D2B52"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.thomasfontes.pawcare",
      "adaptiveIcon": {
        "backgroundColor": "#0D2B52"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O PawCare precisa de acesso à galeria para você selecionar a foto do seu pet.",
          "cameraPermission": "O PawCare precisa de acesso à câmera para você tirar uma foto do seu pet."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F6BFF"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "77b616b0-0ade-482e-84e4-b08d771a2e99"
      }
    }
  }
}
